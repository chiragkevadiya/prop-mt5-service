{
  "MT5": {
    "Live": {
      "Server": "production-mt5-server.com:443",
      "Login": 12345,
      "Password": "your-production-password",
      "Timeout": 30000
    },
    "Demo": {
      "Server": "demo-mt5-server.com:443",
      "Login": 67890,
      "Password": "demo-password",
      "Timeout": 30000
    }
  },
  "Logging": {
    "BasePath": "C:\\MT5ServicesLogSave",
    "SuccessPath": "C:\\MT5ServicesLogSave\\Success",
    "FailedPath": "C:\\MT5ServicesLogSave\\Failed",
    "LogLevel": "Information",
    "EnableFileLogging": true,
    "EnableConsoleLogging": true
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=production-db;Database=PropTradingDB;Username=produser;Password=prodpassword"
  },
  "WebServer": {
    "BaseUri": "http://localhost:8086",
    "Port": 8086,
    "EnableSwagger": false,
    "AutoOpenBrowser": "true"
  },
  "BackgroundJobs": {
    "LiquidationCheckIntervalSeconds": 30,
    "EnableLiquidationMonitor": true
  },
  "ClientEmailSetting": {
    "Host": "smtp.production.com",
    "Port": 587,
    "User": "noreply@proptrading.com",
    "Password": "production-email-password",
    "Mail": "noreply@proptrading.com",
    "DisplayName": "MT5 Prop Trading Service",
    "EnableSsl": true
  }
}
